# Configuração do Supabase para o Tomo
# ATENÇÃO: Conforme RNF-01 e requisitos de segurança, use APENAS a chave pública (anon).
# NUNCA coloque a chave service_role no código ou variáveis de ambiente do frontend!

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Preencher somente depois de cadastrar/publicar a ficha do Tomo na plataforma.
# Sem essas URLs, o app abre a seção de Plugins/Conectores para cadastro manual.
VITE_CHATGPT_PLUGIN_URL=
VITE_CLAUDE_CONNECTOR_URL=
